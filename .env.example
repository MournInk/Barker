# Optional. If omitted, Barker generates a password once and prints it only on the
# first boot. Set 16-300 characters to provide a stable password.
BARKER_PASSWORD=
# Optional. If omitted, Barker stores a generated signing secret in the data directory.
BARKER_SESSION_SECRET=
# Relative to the launch directory, never the standalone directory. Must be outside .next.
BARKER_DATA_DIR=./data
# Optional. Set to 1 only when Barker runs behind a trusted reverse proxy,
# so X-Forwarded-For / X-Real-IP / X-Forwarded-Proto are honored for rate
# limiting and Secure cookies. Never enable when Barker is directly exposed.
BARKER_TRUST_PROXY=
# Optional. Force the Secure flag on the session cookie when TLS is terminated
# outside Barker but BARKER_TRUST_PROXY is not enabled. Defaults to following
# the trusted proxy's X-Forwarded-Proto only.
BARKER_COOKIE_SECURE=
# Docker Compose only. Listen locally by default; put HTTPS behind a reverse proxy.
BARKER_BIND_ADDR=127.0.0.1
BARKER_PORT=3000
