# Optional. If omitted, Barker generates a password and prints it on startup.
BARKER_PASSWORD=
# Optional. If omitted, Barker stores a generated signing secret in the data directory.
BARKER_SESSION_SECRET=
# Optional data directory. Defaults to ./data.
BARKER_DATA_DIR=./data
# Optional. Set to 1 only when Barker runs behind a trusted reverse proxy,
# so X-Forwarded-For / X-Real-IP / X-Forwarded-Proto are honored for rate
# limiting and Secure cookies. Never enable when Barker is directly exposed.
BARKER_TRUST_PROXY=
