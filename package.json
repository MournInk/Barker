{
  "name": "barker",
  "version": "0.2.0",
  "description": "前后端一体的 Next.js 定时提醒小工具，按 cron 周期将提醒可靠推送到自建 Bark API。",
  "author": "MournInk",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "TZ=Asia/Shanghai next dev",
    "build": "next build",
    "start": "TZ=Asia/Shanghai next start",
    "lint": "eslint .",
    "test": "TZ=Asia/Shanghai node --import tsx --test tests/*.test.ts",
    "test:watch": "TZ=Asia/Shanghai node --import tsx --test --watch tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "croner": "^10.0.1",
    "lucide-react": "^1.59.0",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@types/node": "^24.7.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "^15.5.28",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
