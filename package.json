{
  "name": "barker",
  "version": "0.4.2",
  "description": "前后端一体的 Next.js 定时提醒小工具，按 cron 周期将提醒可靠推送到自建 Bark API。",
  "author": "MournInk",
  "private": true,
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=12.0.0"
  },
  "scripts": {
    "dev": "TZ=Asia/Shanghai next dev",
    "build": "next build && node scripts/verify-standalone.mjs",
    "start": "TZ=Asia/Shanghai next start",
    "lint": "eslint .",
    "test": "TZ=Asia/Shanghai node --import tsx --test tests/*.test.ts tests/*.test.mjs",
    "test:watch": "TZ=Asia/Shanghai node --import tsx --test --watch tests/*.test.ts tests/*.test.mjs",
    "test:container": "node scripts/container-smoke.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "@heroui/react": "3.2.7",
    "@heroui/styles": "3.2.7",
    "@iconify-icons/gravity-ui": "2.0.2",
    "@iconify/react": "6.0.4",
    "@internationalized/date": "3.12.4",
    "@react-aria/ssr": "3.10.1",
    "@react-aria/utils": "3.34.1",
    "croner": "^10.0.1",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-aria": "3.53.1",
    "react-aria-components": "1.22.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.7.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.4.2",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@12.14.0"
}
